{
  "name": "magnet-mail",
  "private": true,
  "version": "1.0.0",
  "description": "Magnet Mail – deliver parcels through obstacle courses using nothing but magnetic forces.",
  "author": "Medin Turkes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "solve:levels": "vite-node scripts/solve-levels.ts",
    "smoke": "node scripts/smoke.mjs",
    "android:setup": "node scripts/android-setup.mjs",
    "android:bundle": "node scripts/android-bundle.mjs",
    "ios:setup": "node scripts/ios-setup.mjs",
    "ios:sync": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
